{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Subscriptions": "Data Source=data/subscriptions.db",
    "Billing": "Data Source=data/billing.db"
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingInterval": "00:00:00.500",
    "LeaseDuration": "00:00:30",
    "MaxAttempts": 25,
    "BaseBackoff": "00:00:01",
    "MaxBackoff": "00:00:30"
  },
  "Samples": {
    "Seed": true
  }
}
